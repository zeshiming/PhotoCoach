# PhotoCoach accepts the same names as FridgeMate.
# Never commit a real key.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash

# Optional: load an existing FridgeMate .env instead of duplicating values.
# PHOTOCOACH_ENV_FILE=/Users/zeshiming/Documents/Codex/2026-07-31/lan/fridgemate/.env

LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1024

# Optional real vision tool. Do not commit a real key.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_VISION_MODEL=glm-4v-flash
GLM_TIMEOUT=60
GLM_MAX_RETRIES=2
GLM_MAX_TOKENS=1024
